@baseUrl = http://localhost:8081/api

@adminAuthToken = PASTE_ADMIN_AUTH_TOKEN_HERE

### Redragon Surara Mechanical RGB Gaming Keyboard - Black
POST {{baseUrl}}/productcatalog
Content-Type: application/json
Authorization: Bearer {{adminAuthToken}}

{
  "sku": "ACC-KB-REDRAGON-SURARA",
  "productName": "Redragon Surara Mechanical RGB Gaming Keyboard - Black",
  "description": "Full-size mechanical RGB gaming keyboard.",
  "brand": "REDRAGON",
  "category": "ACCESSORIES",
  "price": 799.00,
  "stockQuantity": 40,
  "primaryImageUrl": "/images/products/accessories/redragon-surara-keyboard.jpg",
  "colour": "Black"
}

