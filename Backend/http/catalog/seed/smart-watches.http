@baseUrl = http://localhost:8081/api

@adminAuthToken = PASTE_ADMIN_AUTH_TOKEN_HERE

# Requires ../../auth.http administrator login first.

### Huawei Watch Fit 3 GPS 43mm
POST {{baseUrl}}/productcatalog
Content-Type: application/json
Authorization: Bearer {{adminAuthToken}}

{
  "sku": "WATCH-HUAWEI-FIT3",
  "productName": "Huawei Watch Fit 3 GPS 43mm",
  "description": "Slim GPS fitness smart watch with AMOLED display.",
  "brand": "HUAWEI",
  "category": "SMART_WATCHES",
  "price": 1999.00,
  "stockQuantity": 30,
  "primaryImageUrl": "/images/products/smart-watches/huawei-watch-fit-3.png",
  "colour": "Black",
  "featured": true
}

