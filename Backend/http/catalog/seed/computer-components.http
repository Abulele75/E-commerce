@baseUrl = http://localhost:8081/api

# Requires ../../auth.http administrator login first.

@adminAuthToken = PASTE_ADMIN_AUTH_TOKEN_HERE

### NVIDIA GeForce RTX 5060 GPU
POST {{baseUrl}}/productcatalog
Content-Type: application/json
Authorization: Bearer {{adminAuthToken}}

{
  "sku": "COMP-GPU-RTX5060",
  "productName": "NVIDIA GeForce RTX 5060 GPU",
  "description": "Mid-range graphics card for 1080p/1440p gaming.",
  "brand": "NVIDIA",
  "category": "COMPUTER_COMPONENTS",
  "componentType": "GRAPHICS_CARD",
  "price": 8999.00,
  "stockQuantity": 15,
  "primaryImageUrl": "/images/products/components/nvidia-rtx-5060.png",
  "powerRequirementWatts": 550,
  "componentFormFactor": "Dual-slot"
}

