@baseUrl = http://localhost:8081/api

# Requires ../../auth.http administrator login first.

@adminAuthToken = PASTE_ADMIN_AUTH_TOKEN_HERE

### Apple iPhone 11 64GB
POST {{baseUrl}}/productcatalog
Content-Type: application/json
Authorization: Bearer {{adminAuthToken}}

{
  "sku": "IPHONE11",
  "productName": "IPHONE 11 64GB",
  "description": "Beauty and power at once.",
  "brand": "APPLE",
  "category": "SMARTPHONES",
  "price": 10999.00,
  "stockQuantity": 5,
  "primaryImageUrl": "/images/products/smartphones/Iphone11.png",
  "colour": "Titanium black"
}

