@baseUrl = http://localhost:8081/api

@adminAuthToken = PASTE_ADMIN_AUTH_TOKEN_HERE

### Lenovo Legion Gaming Laptop
POST {{baseUrl}}/productcatalog
Content-Type: application/json
Authorization: Bearer {{adminAuthToken}}

{
  "sku": "LAPTOP-LEGION",
  "productName": "Lenovo Legion Gaming Laptop",
  "description": "High-performance gaming laptop.",
  "brand": "LEGION",
  "category": "LAPTOPS",
  "price": 24999.00,
  "stockQuantity": 10,
  "primaryImageUrl": "/images/products/laptops/legion-front.png",
  "secondaryImageUrl": "/images/products/laptops/legion-back.png",
  "processor": "Intel Core i7",
  "memory": "16GB",
  "storage": "1TB SSD",
  "operatingSystem": "Windows 11",
  "graphicsCard": "NVIDIA GeForce RTX 4060",
  "warrantyPeriodMonths": 24,
  "featured": true
}

