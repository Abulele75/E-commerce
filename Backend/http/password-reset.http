@baseUrl = http://localhost:8081/api

### Request a local-development password reset token
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "{{customerEmail}}"
}

> {% client.global.set("passwordResetToken", response.body.developmentResetToken); %}

### Reset the password with the single-use token
# Update the private environment password after this succeeds.
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{
  "token": "{{passwordResetToken}}",
  "newPassword": "NewPassword@12345",
  "confirmPassword": "NewPassword@12345"
}
