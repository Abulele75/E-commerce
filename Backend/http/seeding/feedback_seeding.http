@customerToken = PASTE_CUSTOMER_JWT_HERE
@productId = PASTE_PURCHASED_PRODUCT_ID_HERE
@orderId = PASTE_DELIVERED_ORDER_ID_HERE

# Product reviews require a paid purchase and allow one review per customer/product.
### SEED VERIFIED PRODUCT REVIEW
POST http://localhost:8081/api/feedback/product-reviews
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "targetProductId": "{{productId}}",
  "hardwareStarRating": 5,
  "comprehensiveReviewText": "Excellent performance, premium build quality and reliable battery life. The product matched its catalogue description and has worked perfectly."
}

# Delivery reviews require ownership of an order whose status is DELIVERED.
### SEED VERIFIED DELIVERY SERVICE REVIEW
POST http://localhost:8081/api/feedback/delivery-reviews
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "orderId": "{{orderId}}",
  "courierFulfillmentRating": 5,
  "packageConditionFeedback": "The courier arrived within the expected delivery window. The parcel was sealed, undamaged and handled professionally."
}
