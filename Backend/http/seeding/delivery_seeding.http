@adminToken = PASTE_ADMIN_JWT_HERE
@orderId = PASTE_PAID_ORDER_ID_HERE
@deliveryId = PASTE_CREATED_DELIVERY_ID_HERE

# Run payment_seeding.http first and paste the paid ORD-* ID above.
### CREATE DELIVERY
POST http://localhost:8081/api/deliveries
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "orderId": "{{orderId}}",
  "trackingNumber": "ICT-ZA-000001",
  "carrier": "The Courier Guy",
  "carrierContact": "support@example.co.za"
}

> {% client.global.set("deliveryId", response.body.deliveryId); %}

### TRACK DISPATCHED DELIVERY
POST http://localhost:8081/api/deliveries/{{deliveryId}}/tracking
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "deliveryStatus": "DISPATCHED",
  "currentLocation": "Cape Town Distribution Centre",
  "statusMessage": "The parcel has been collected and dispatched."
}

### TRACK DELIVERY IN TRANSIT
POST http://localhost:8081/api/deliveries/{{deliveryId}}/tracking
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "deliveryStatus": "IN_TRANSIT",
  "currentLocation": "Cape Town Central Depot",
  "statusMessage": "The parcel is in transit to the local delivery depot."
}

### TRACK DELIVERY OUT FOR DELIVERY
POST http://localhost:8081/api/deliveries/{{deliveryId}}/tracking
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "deliveryStatus": "OUT_FOR_DELIVERY",
  "currentLocation": "Cape Town City Centre",
  "statusMessage": "The parcel is with the courier and is out for delivery."
}

### TRACK DELIVERED ORDER
POST http://localhost:8081/api/deliveries/{{deliveryId}}/tracking
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "deliveryStatus": "DELIVERED",
  "currentLocation": "12 Long Street, Cape Town",
  "statusMessage": "The parcel was delivered to the recipient."
}
